{
	"extends": "$app/tsconfig",
	"include": ["src", "e2e", "*.ts"],
	"exclude": ["src/service-worker"],
	"compilerOptions": {
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"types": ["$app/types", "vite/client", "node"]
	}
}
