{
	"name": "sweetfolio",
	"version": "0.5.4",
	"private": true,
	"license": "EUPL-1.2",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*",
		"#test/*": "./src/test/*"
	},
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"licenses:check": "node scripts/licenses.mjs check",
		"licenses:notices": "node scripts/licenses.mjs notices"
	},
	"dependencies": {
		"lz-string": "1.5.0",
		"uplot": "1.6.32"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "22.20.5",
		"fake-indexeddb": "6.2.5",
		"jsdom": "30.1.3",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3",
		"vite": "8.3.4",
		"vitest": "5.0.5"
	}
}
